{
  "name": "@evertondgn/solid-tooling",
  "version": "0.5.0",
  "description": "Lint, formatter, TypeScript, test and Vite app presets for SolidJS applications built with Vite+.",
  "author": "Éverton Toffanetto",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/everton-dgn/solidjs_base.git",
    "directory": "packages/solid-tooling"
  },
  "keywords": [
    "solidjs",
    "solid",
    "vite",
    "vite-plus",
    "nitro",
    "ssr",
    "oxlint",
    "oxfmt",
    "lint",
    "formatter",
    "tsconfig",
    "typescript",
    "vitest",
    "playwright",
    "knip",
    "stylelint",
    "paraglide",
    "i18n",
    "preset"
  ],
  "type": "module",
  "files": [
    "dist",
    "tsconfig.base.json",
    "tsconfig.app.json",
    "virtual-modules.d.ts",
    "lefthook.yml",
    "app-env.d.ts",
    "node-env.d.ts"
  ],
  "exports": {
    "./architecture-plugin": "./dist/architecture-plugin.mjs",
    "./backend-plugin": "./dist/backend-plugin.mjs",
    "./cli": "./dist/cli.mjs",
    "./commitlint": "./dist/commitlint.mjs",
    "./css-filename": "./dist/css-filename.mjs",
    "./env": "./dist/env.mjs",
    "./fmt": "./dist/fmt.mjs",
    "./i18n-generate": "./dist/i18n-generate.mjs",
    "./knip": "./dist/knip.mjs",
    "./lint": "./dist/lint.mjs",
    "./playwright": "./dist/playwright.mjs",
    "./playwright-teardown": "./dist/playwright-teardown.mjs",
    "./project-plugin": "./dist/project-plugin.mjs",
    "./solid-plugin": "./dist/solid-plugin.mjs",
    "./stylelint": "./dist/stylelint.mjs",
    "./vite": "./dist/vite.mjs",
    "./vitest": "./dist/vitest.mjs",
    "./vitest-setup/browser": "./dist/vitest-setup/browser.mjs",
    "./package.json": "./package.json",
    "./tsconfig.base.json": "./tsconfig.base.json",
    "./tsconfig.app.json": "./tsconfig.app.json",
    "./app-env": {
      "types": "./app-env.d.ts"
    },
    "./virtual-modules": {
      "types": "./virtual-modules.d.ts"
    },
    "./lefthook.yml": "./lefthook.yml"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp run test-rules",
    "test:tarball": "vp run test-tarball"
  },
  "dependencies": {
    "@commitlint/config-conventional": "21.2.4",
    "eslint-plugin-solid": "0.19.0",
    "stylelint": "18.0.0",
    "stylelint-use-nesting": "6.0.2",
    "@inlang/sdk": "4.2.0",
    "valibot": "1.5.0",
    "@playwright/test": "1.65.0",
    "@solidjs/vite-plugin": "3.0.0-next.57",
    "filesystem-routing": "0.5.0",
    "knip": "6.45.1",
    "nitro": "3.0.261103-rc",
    "unplugin-icons": "24.0.0",
    "@commitlint/cli": "21.2.4",
    "lefthook": "2.2.2",
    "happy-dom": "21.0.4",
    "playwright": "1.65.0",
    "@vitest/browser-playwright": "5.1.0",
    "@vitest/coverage-v8": "5.1.0",
    "@vitest/ui": "5.1.0",
    "@testing-library/jest-dom": "7.0.1",
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@inlang/paraglide-js": "3.2.2",
    "vite-plus": "1.6.0"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "3.2.2",
    "vite-plus": "catalog:",
    "@inlang/plugin-message-format": "4.6.0"
  },
  "peerDependenciesMeta": {
    "@inlang/paraglide-js": {
      "optional": true
    }
  }
