{
  "name": "solidjs_base",
  "version": "0.0.0",
  "private": true,
  "author": "Éverton Toffanetto",
  "license": "MIT",
  "repository": "https://github.com/everton-dgn/solidjs_base",
  "description": "Shared packages for SolidJS applications built with Vite+.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "vp run --filter './packages/*' build",
    "check": "vp check && vp run --filter './packages/*' check",
    "dead-code": "vp run --filter './packages/*' dead-code",
    "test": "vp run --filter './packages/*' test && vp run test:release",
    "test:release": "node --test 'tooling/release/**/__tests__/*.test.ts'",
    "test:tarball": "vp run --filter './packages/*' test:tarball",
    "validate": "vp run build:published && vp run check && vp run dead-code && vp run test:published && vp run test:tarball:published && vp run test:consistency && vp run test:scenarios:published && vp run test:ci",
    "test:scenarios": "vp run test:scenarios:published && node packages/create-solid/tooling/scenario.ts",
    "release:merge": "node tooling/release/merge-pull-request.ts",
    "test:consistency": "node --test packages/solid-tooling/src/tarball/__tests__/tarball.workspaceConsistency.test.ts",
    "validate:generator": "vp run build && vp check && vp run --fail-if-no-match --filter @evertondgn/create-solid test:validated && vp run --fail-if-no-match --filter @evertondgn/create-solid test:tarball",
    "build:published": "vp run --fail-if-no-match --filter './packages/*' --filter '!@evertondgn/create-solid' build",
    "test:published": "vp run --fail-if-no-match --filter './packages/*' --filter '!@evertondgn/create-solid' test && vp run test:release",
    "test:tarball:published": "vp run --fail-if-no-match --filter './packages/*' --filter '!@evertondgn/create-solid' test:tarball",
    "test:scenarios:published": "node --test --test-timeout=180000 packages/solid-tooling/src/tarball/__tests__/tarball.scenarios.test.ts",
    "test:ci": "node --test 'tooling/ci/__tests__/*.test.ts'"
  },
  "devDependencies": {
    "@evertondgn/solid-tooling": "workspace:*",
    "@inlang/paraglide-js": "3.2.2",
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "yaml": "2.9.1"
  },
  "overrides": {
    "@solidjs/compiler": "2.0.2",
    "@solidjs/signals": "2.0.3",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=26.13.1 <27"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.1",
      "onFail": "download"
    }
  },
  "catalog": {
    "valibot": "1.5.0",
    "@vitest/browser-playwright": "5.1.0",
    "@vitest/coverage-v8": "5.1.0",
    "@vitest/ui": "5.1.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@8.3.8000",
    "vite-plus": "1.7.0",
    "vitest": "5.1.0",
    "tsrs": "7.1.0-beta.tsrs2",
    "schema-dts": "2.1.0",
    "@mdream/js": "2.2.0"
  },
  "patchedDependencies": {
    "@mdream/js@2.2.0": "apps/boilerplate/patches/@mdream%2Fjs@2.2.0.patch"
  },
  "trustedDependencies": []
}
