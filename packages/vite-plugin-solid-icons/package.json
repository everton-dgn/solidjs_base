{
  "name": "@evertondgn/vite-plugin-solid-icons",
  "version": "0.9.0",
  "description": "Vite plugin that turns Iconify collections and folders of SVG files into SolidJS 2 components.",
  "author": "Éverton Toffanetto",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/everton-dgn/solidjs_base.git",
    "directory": "packages/vite-plugin-solid-icons"
  },
  "keywords": [
    "solidjs",
    "solid",
    "vite",
    "vite-plus",
    "vite-plugin",
    "icons",
    "iconify",
    "svg"
  ],
  "type": "module",
  "engines": {
    "node": ">=26.13.1"
  },
  "files": [
    "dist",
    "icon-modules.d.ts"
  ],
  "exports": {
    ".": "./dist/index.mjs",
    "./types": "./dist/types.mjs",
    "./package.json": "./package.json",
    "./icon-modules": {
      "types": "./icon-modules.d.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp run test-plugin",
    "test:tarball": "vp run test-tarball",
    "dead-code": "knip-bun && knip-bun --strict"
  },
  "dependencies": {
    "@iconify/utils": "3.1.7",
    "magic-string": "1.4.5"
  },
  "peerDependencies": {
    "@solidjs/web": "2.0.0-rc.23",
    "vite-plus": "1.7.0"
  },
  "devDependencies": {
    "@iconify-json/hugeicons": "1.2.36",
    "@solidjs/vite-plugin": "3.0.0-next.57",
    "@solidjs/web": "2.0.0-rc.23",
    "@types/node": "26.6.6",
    "knip": "6.45.1",
    "playwright": "1.65.1",
    "solid-js": "2.0.0-rc.23",
    "tsrs": "catalog:",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  }
}
