{
  "name": "solidjs_base",
  "version": "0.0.0",
  "private": true,
  "author": "Éverton Toffanetto",
  "license": "MIT",
  "repository": "https://github.com/everton-dgn/solidjs_base",
  "description": "Shared packages for SolidJS applications built with Vite+.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "vp run --filter './packages/*' build",
    "check": "vp check && vp run --filter './packages/*' check",
    "dead-code": "vp run --filter './packages/*' dead-code",
    "test": "vp run --filter './packages/*' test && vp run test:release",
    "test:release": "node --test 'tooling/release/**/__tests__/*.test.ts'",
    "test:tarball": "vp run --filter './packages/*' test:tarball",
    "validate": "vp run build && vp run check && vp run dead-code && vp run test && vp run test:tarball && vp run test:scenarios",
    "test:scenarios": "node --test --test-timeout=180000 packages/solid-tooling/src/tarball/__tests__/tarball.scenarios.test.ts",
    "release:merge": "node tooling/release/merge-pull-request.ts"
  },
  "devDependencies": {
    "@evertondgn/solid-tooling": "workspace:*",
    "@inlang/paraglide-js": "3.2.2",
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "overrides": {
    "@solidjs/compiler": "2.0.0-rc.23",
    "@solidjs/signals": "2.0.0-rc.23",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=26.13.1 <27"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.1",
      "onFail": "download"
    }
  },
  "catalog": {
    "valibot": "1.5.0",
    "@vitest/browser-playwright": "5.1.0",
    "@vitest/coverage-v8": "5.1.0",
    "@vitest/ui": "5.1.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.6.0",
    "vite-plus": "1.6.0",
    "vitest": "5.1.0",
    "schema-dts": "2.1.0",
    "@mdream/js": "2.1.0"
  },
  "patchedDependencies": {
    "@mdream/js@2.1.0": "apps/boilerplate/patches/@mdream%2Fjs@2.1.0.patch"
  },
  "trustedDependencies": []
}
