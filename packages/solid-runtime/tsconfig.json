{
  "extends": "../solid-tooling/tsconfig.base.json",
  "compilerOptions": {
    "types": [
      "node",
      "vite/client",
      "vite-plus/test/globals",
      "@solidjs/vite-plugin/virtual-modules",
      "filesystem-routing/types",
      "@solidjs/vite-plugin/boundary-modules"
    ],
    "paths": {
      "@paraglide/*": ["./tooling/testing/generated/*"],
      "@testing/*": ["./tooling/testing/*"],
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src",
    "tooling",
    "vite.config.ts",
    "knip.config.ts",
    "../solid-tooling/virtual-modules.d.ts"
  ]
}
