{
  "private": true,
  "name": "@evertondgn/create-solid",
  "version": "0.10.0",
  "description": "Generate a standalone Solid Base application.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=26.13.1"
  },
  "exports": {
    "types": "./dist/index.d.ts",
    "default": "./dist/index.mjs"
  },
  "bin": {
    "create-solid": "./dist/create-solid.mjs"
  },
  "files": [
    "dist",
    "!dist/formatter",
    "template",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node tooling/build.ts",
    "test": "node --test __tests__/*.test.ts",
    "test:tarball": "node tooling/parity.ts"
  },
  "devDependencies": {
    "@evertondgn/solid-tooling": "workspace:*",
    "@inlang/plugin-message-format": "4.6.0",
    "oxc-parser": "0.156.0",
    "valibot": "catalog:"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/everton-dgn/solidjs_base.git",
    "directory": "packages/create-solid"
  }
}
