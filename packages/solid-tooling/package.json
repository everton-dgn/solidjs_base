{
  "name": "@evertondgn/solid-tooling",
  "version": "0.3.0",
  "description": "Lint, formatter, TypeScript, test and Vite app presets for SolidJS applications built with Vite+.",
  "author": "Éverton Toffanetto",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/everton-dgn/solidjs_base.git",
    "directory": "packages/solid-tooling"
  },
  "keywords": [
    "solidjs",
    "vite-plus",
    "oxlint",
    "lint",
    "tsconfig"
  ],
  "type": "module",
  "files": [
    "dist",
    "tsconfig.base.json",
    "tsconfig.app.json"
  ],
  "exports": {
    "./architecture-plugin": "./dist/architecture-plugin.mjs",
    "./backend-plugin": "./dist/backend-plugin.mjs",
    "./css-filename": "./dist/css-filename.mjs",
    "./fmt": "./dist/fmt.mjs",
    "./knip": "./dist/knip.mjs",
    "./lint": "./dist/lint.mjs",
    "./playwright": "./dist/playwright.mjs",
    "./playwright-teardown": "./dist/playwright-teardown.mjs",
    "./project-plugin": "./dist/project-plugin.mjs",
    "./solid-plugin": "./dist/solid-plugin.mjs",
    "./stylelint": "./dist/stylelint.mjs",
    "./vite": "./dist/vite.mjs",
    "./vitest": "./dist/vitest.mjs",
    "./vitest-setup/browser": "./dist/vitest-setup/browser.mjs",
    "./package.json": "./package.json",
    "./tsconfig.base.json": "./tsconfig.base.json",
    "./tsconfig.app.json": "./tsconfig.app.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp run test-rules",
    "test:tarball": "vp run test-tarball"
  },
  "dependencies": {
    "eslint-plugin-solid": "0.19.0",
    "stylelint": "18.0.0",
    "stylelint-use-nesting": "6.0.2"
  },
  "peerDependencies": {
    "@inlang/paraglide-js": "3.2.2",
    "vite-plus": "1.6.0",
    "@playwright/test": "1.65.0",
    "@solidjs/vite-plugin": "3.0.0-next.57",
    "filesystem-routing": "0.5.0",
    "knip": "6.45.1",
    "nitro": "3.0.261103-rc",
    "unplugin-icons": "24.0.0"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "3.2.2",
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "valibot": "1.5.0",
    "vite-plus": "catalog:",
    "@playwright/test": "1.65.0",
    "@solidjs/vite-plugin": "3.0.0-next.57",
    "filesystem-routing": "0.5.0",
    "knip": "6.45.1",
    "nitro": "3.0.261103-rc",
    "unplugin-icons": "24.0.0"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    },
    "@solidjs/vite-plugin": {
      "optional": true
    },
    "filesystem-routing": {
      "optional": true
    },
    "knip": {
      "optional": true
    },
    "nitro": {
      "optional": true
    },
    "unplugin-icons": {
      "optional": true
    }
  }
}
