// Local preview of the files and the per-page headers that the host will serve.
import { readFile } from 'node:fs/promises'
import { createServer, type IncomingMessage, type ServerResponse } from 'node:http'
import path from 'node:path'
import process from 'node:process'
import { URL } from 'node:url'

import { array, object, parse, record, string } from 'valibot'

const root = path.resolve('.output/public')
const hashesSchema = array(string())
const schema = object({ pages: record(string(), hashesSchema) })
const manifest = await readFile('.output/csp-hashes.json', 'utf8')
const { pages } = parse(schema, JSON.parse(manifest))
const badRequest = 400
const notFound = 404
const types: Record<string, string> = {
  '.html': 'text/html; charset=utf-8',
  '.js': 'text/javascript',
  '.css': 'text/css',
  '.json': 'application/json',
  '.svg': 'image/svg+xml',
  '.woff2': 'font/woff2',
  '.xml': 'application/xml',
  '.md': 'text/markdown',
  '.txt': 'text/plain'
}

async function serve(request: IncomingMessage, response: ServerResponse): Promise<void> {
  try {
    const pathname = decodeURIComponent(new URL(request.url ?? '/', 'http://localhost').pathname)
    const file = path.resolve(root, `.${pathname}`)
    if (file !== root && !file.startsWith(`${root}${path.sep}`)) {
      response.writeHead(badRequest).end()
      return
    }
    let target = path.extname(file) ? file : path.join(file, 'index.html')
    let data
    try {
      data = await readFile(target)
    } catch {
      const [, locale] = pathname.split('/')
      const localized = `/${locale}/404.html`
      target = path.join(root, Object.hasOwn(pages, localized) ? localized : '404.html')
      data = await readFile(target)
      response.statusCode = notFound
    }
    const hashes = pages[`/${path.relative(root, target)}`]
    if (hashes) {
      const scripts = ["'self'", ...hashes.map(hash => `'${hash}'`)].join(' ')
      response.setHeader('Content-Security-Policy', `default-src 'self'; script-src ${scripts}; style-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'`)
    }
    response.setHeader('Content-Type', types[path.extname(target)] ?? 'application/octet-stream')
    response.end(data)
  } catch {
    response.writeHead(badRequest).end()
  }
}

createServer((request, response) => {
  void serve(request, response)
}).listen(Number(process.env.PORT ?? '4317'), '127.0.0.1')
