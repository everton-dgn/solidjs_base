{
  "name": "@everton-dgn/solid-tooling",
  "version": "0.1.0",
  "description": "Lint, formatter and TypeScript presets for SolidJS applications built with Vite+.",
  "author": "Éverton Toffanetto",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/everton-dgn/solidjs_base.git",
    "directory": "packages/solid-tooling"
  },
  "keywords": [
    "solidjs",
    "vite-plus",
    "oxlint",
    "lint",
    "tsconfig"
  ],
  "type": "module",
  "files": [
    "dist",
    "tsconfig.base.json"
  ],
  "exports": {
    "./architecture-plugin": "./dist/architecture-plugin.mjs",
    "./backend-plugin": "./dist/backend-plugin.mjs",
    "./css-filename": "./dist/css-filename.mjs",
    "./fmt": "./dist/fmt.mjs",
    "./lint": "./dist/lint.mjs",
    "./project-plugin": "./dist/project-plugin.mjs",
    "./solid-plugin": "./dist/solid-plugin.mjs",
    "./package.json": "./package.json",
    "./tsconfig.base.json": "./tsconfig.base.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp run test-rules",
    "test:tarball": "vp run test-tarball",
    "prepublishOnly": "vp pack"
  },
  "dependencies": {
    "eslint-plugin-solid": "0.19.0"
  },
  "peerDependencies": {
    "@inlang/paraglide-js": "3.2.2",
    "vite-plus": "1.6.0"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "3.2.2",
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "valibot": "1.5.0",
    "vite-plus": "catalog:"
  }
}
