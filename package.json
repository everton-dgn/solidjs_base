{
  "name": "solidjs_base",
  "version": "0.0.0",
  "private": true,
  "author": "Éverton Toffanetto",
  "license": "MIT",
  "repository": "https://github.com/everton-dgn/solidjs_base",
  "description": "Shared packages for SolidJS applications built with Vite+.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "vp run --filter './packages/*' build",
    "check": "vp check && vp run --filter './packages/*' check",
    "test": "vp run --filter './packages/*' test",
    "test:tarball": "vp run --filter './packages/*' test:tarball",
    "validate": "vp run build && vp run check && vp run test && vp run test:tarball"
  },
  "devDependencies": {
    "@evertondgn/solid-tooling": "workspace:*",
    "@inlang/paraglide-js": "3.2.2",
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "overrides": {
    "@solidjs/compiler": "2.0.0-rc.21",
    "@solidjs/signals": "2.0.0-rc.21",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.22.3",
      "onFail": "download"
    }
  },
  "catalog": {
    "@vitest/browser-playwright": "5.1.0",
    "@vitest/coverage-v8": "5.1.0",
    "@vitest/ui": "5.1.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.6.0",
    "vite-plus": "1.6.0",
    "vitest": "5.1.0"
  },
  "patchedDependencies": {
    "@mdream/js@2.1.0": "apps/boilerplate/patches/@mdream%2Fjs@2.1.0.patch",
    "@solidjs/web@2.0.0-rc.21": "apps/boilerplate/patches/@solidjs%2Fweb@2.0.0-rc.21.patch"
  }
}
